# Copy to ".env" and fill real values. .env is gitignored.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ilaaj_crm
DB_USER=root
DB_PASS=

# --- Google Drive OAuth ---
# Create Web application OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtained once via Editor → Drive Setup → Connect Google Drive
GOOGLE_REFRESH_TOKEN=

# Folder ID or full Drive folder URL
GOOGLE_DRIVE_FOLDER_ID=

# On production, set this to your live callback and add it in Google Cloud:
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/google_oauth.php

GOOGLE_DRIVE_MAKE_PUBLIC=true
